#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(git rev-parse --show-toplevel 2>/dev/null || true)"
if [ -z "$ROOT_DIR" ]; then
  ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
fi

# Trigger Jenkins on every local commit.
# Customize via env vars or edit defaults in scripts/trigger-jenkins.sh.
"$ROOT_DIR/scripts/trigger-jenkins.sh"
